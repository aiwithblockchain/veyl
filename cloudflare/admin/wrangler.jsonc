{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veyl-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Access 可以直接保护 workers.dev 地址（按单个 Worker 限定），这条地址本身就是
  // 被门禁的入口。安全边界在 Worker 自己验 `Cf-Access-Jwt-Assertion`，不在边缘：
  // 地址可见不等于可访问，没有合法 JWT 一律 401。见文件末尾的路由说明。
  "workers_dev": true,
  // 关闭 Version URLs 与 workers.dev Preview URLs。Deployment URL 没有对应的
  // wrangler 开关，官方建议把 Access 应用的范围设成同时覆盖 production 与
  // preview/deployment，别只保护 production。
  "preview_urls": false,
  // 必须关掉 keep_names：页面里的「查看健康」脚本是把 src/client.ts 的函数用
  // toString() 原样嵌进 HTML 的。开着 keep_names 时 esbuild 会在函数体里注入
  // __name(...) 调用，而那个 helper 定义在模块作用域，浏览器里并不存在——
  // 脚本会直接 ReferenceError。关掉之后函数体不含任何外部引用。
  // 改这一行之前先跑一次 `wrangler deploy --dry-run` 并检查产出里没有 __name。
  "keep_names": false,
  "observability": {
    "enabled": true
  },
  // 运维看板直接读控制面的库。运维不分环境：一个 worker 同时绑生产与 dev 两份，
  // 界面上按环境分标签。见 agent/docs/agent-health.md §5.6。
  "d1_databases": [
    {
      "binding": "DB_PROD",
      "database_name": "veyl-control-plane",
      "database_id": "736d423d-47bb-435c-8d74-dfe9244c5833"
    },
    {
      "binding": "DB_DEV",
      "database_name": "veyl-control-plane-dev-4",
      "database_id": "a5755c55-b1d3-41fa-a2e1-e6a6a6627824"
    }
  ],
  // node:tls 用来连 agent 的自签证书端点，信任锚是我们自己的 CA（servers.ca_pem）。
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://tweetcat.cloudflareaccess.com",
    // Access 应用「Veyl Admin」的 Application Audience Tag：校验 JWT 的 aud，
    // 确认令牌确实是签给这个应用的。不是密钥，可以入库。
    "ACCESS_AUD": "71d03d7d105ddf60911c1374406918b5442cf641ed7760a08e5a18a6497bb47d"
  },
  // Secrets（wrangler secret put，不写在此文件）：
  // - OPS_TOKEN_SIGNING_JWK（运维只读票的 Ed25519 **私钥** JWK）。只在这里，
  //   控制面只拿它的公钥（OPS_TOKEN_PUBLIC_JWK），两边私钥互不持有。
  //   未设置时页面照常显示，只是点「签只读票」回 503。
  // 自定义域名要求 dessage.xyz 是本账号下的 zone。它目前托管在 GoDaddy 的 DNS 上，
  // 而 Worker 无法通过外部 CNAME 接入自定义主机名（Cloudflare 按 Host 头在自己的
  // zone 里路由）。所以先走 workers.dev，由 Access 在该地址上做门禁。
  // 若将来 dessage.xyz 迁入本账号，改用：
  //   "routes": [{ "pattern": "admin.dessage.xyz", "zone_name": "dessage.xyz", "custom_domain": true }]
  "routes": []
}

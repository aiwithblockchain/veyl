{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veyl-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Access 只保护自定义域名，workers.dev 必须关掉，否则绕过 Access 直连 Worker。
  // 例外：Access 可以直接保护 workers.dev 地址（按单个 Worker 限定），此时这条地址
  // 本身就是被 Access 门禁的入口，不再算绕过。见文件末尾的路由说明。
  "workers_dev": true,
  // 预览地址同样不受 Access 保护，钉死关闭，防止默认值将来变化。
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    // 填成 https://<your-team>.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "",
    // 填成 Access 应用的 Application Audience (AUD) Tag
    "ACCESS_AUD": ""
  },
  // 自定义域名要求 dessage.xyz 是本账号下的 zone。它目前托管在 GoDaddy 的 DNS 上，
  // 而 Worker 无法通过外部 CNAME 接入自定义主机名（Cloudflare 按 Host 头在自己的
  // zone 里路由）。所以先走 workers.dev，由 Access 在该地址上做门禁。
  // 若将来 dessage.xyz 迁入本账号，改用：
  //   "routes": [{ "pattern": "admin.dessage.xyz", "zone_name": "dessage.xyz", "custom_domain": true }]
  "routes": []
}

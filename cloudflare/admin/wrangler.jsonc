{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veyl-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Access 可以直接保护 workers.dev 地址（按单个 Worker 限定），这条地址本身就是
  // 被门禁的入口。安全边界在 Worker 自己验 `Cf-Access-Jwt-Assertion`，不在边缘：
  // 地址可见不等于可访问，没有合法 JWT 一律 401。见文件末尾的路由说明。
  "workers_dev": true,
  // 关闭 Version URLs 与 workers.dev Preview URLs。Deployment URL 没有对应的
  // wrangler 开关，官方建议把 Access 应用的范围设成同时覆盖 production 与
  // preview/deployment，别只保护 production。
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    // 填成 https://<your-team>.cloudflareaccess.com
    "ACCESS_TEAM_DOMAIN": "",
    // 填成 Access 应用的 Application Audience (AUD) Tag
    "ACCESS_AUD": ""
  },
  // 自定义域名要求 dessage.xyz 是本账号下的 zone。它目前托管在 GoDaddy 的 DNS 上，
  // 而 Worker 无法通过外部 CNAME 接入自定义主机名（Cloudflare 按 Host 头在自己的
  // zone 里路由）。所以先走 workers.dev，由 Access 在该地址上做门禁。
  // 若将来 dessage.xyz 迁入本账号，改用：
  //   "routes": [{ "pattern": "admin.dessage.xyz", "zone_name": "dessage.xyz", "custom_domain": true }]
  "routes": []
}

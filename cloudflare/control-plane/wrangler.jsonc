{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "veyl-control-plane",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// 国内分流规则集：import 进 Worker 时按 Data 模块打成 ArrayBuffer（src/rules.ts 只读下发）。
	// .srs 给 sing-box，.mrs 给 Clash；fallthrough 让默认的 `.bin` 规则继续生效。
	"rules": [{ "type": "Data", "globs": ["**/*.srs", "**/*.mrs"], "fallthrough": true }],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// 让 Worker 尽量在离上游（Vultr API）近的机房执行，出口 IP 随之变化。
	"placement": {
		"mode": "smart"
	},
	// 每小时计费：到期前 1 小时进入可扣窗口，续期扣费、补建「已付没机器」、对账
	// （login-and-payment.md §4.6）。没有这一段，scheduled() 永远不会触发；
	// 时间是 UTC，避开整点高峰（每小时第 17 分）。
	"triggers": {
		"crons": ["17 * * * *"]
	},
	// 默认环境 = 生产。部署：npm run deploy
	"vars": {
		"ENVIRONMENT": "production",
		// 写进 cloud-init 的回传地址；必须与部署后的实际地址一致。
		"ENROLL_BASE_URL": "https://veyl.dessage.xyz",
		// 生产使用独立的凭据签名密钥（dev 是 cp-2026-11），公钥内置在客户端。
		"CREDENTIAL_KEY_ID": "cp-2026-12",
		// Dodo Live 充值产品；键是美分面额。dev 用 Test 产品，两套不混用。
		"DODO_TOPUP_PRODUCT_IDS": "{\"1000\":\"pdt_0Ns2WjoaqgohcfZ9r254A\",\"2000\":\"pdt_0Ns2Wjd7xrFjmLr2oZvnL\",\"5000\":\"pdt_0Ns2Wj265kTDA5UA0JmkG\",\"10000\":\"pdt_0Ns2WicUqf6BC786Vv0xG\"}",
		// 日价（USD 分/天）是唯一售价真源，月价 = 日价 × 30。
		"PLAN_DAILY_PRICE_CENTS": "{\"s-1vcpu-512mb-10gb\":20,\"s-1vcpu-1gb\":30,\"s-1vcpu-2gb\":60}",
		"APP_PAYMENT_RETURN_URL": "https://veyl.dessage.xyz/"
	},
	// Secrets（通过 wrangler secret put 设置，不写在此文件）：
	// - DO_API_TOKEN（DigitalOcean；缺省时 /v1/catalog 返回 503）
	// - VULTR_API_KEY（历史遗留，已无路由使用；可从两个 Worker 上删除）
	// - DODO_API_KEY / DODO_WEBHOOK_SECRET（dev、prod 各一套，test 与 live 不混用）
	// - RESEND_API_KEY / RESEND_FROM_EMAIL（邮箱验证码）
	"env": {
		// 开发 / 联调环境。部署：npm run deploy:dev
		// main 指向 dev 入口：只有这里装配 /v1/debug/*，生产入口不 import 它。
		"dev": {
			"name": "veyl-control-plane-dev",
			"main": "src/dev.ts",
			"vars": {
				"ENVIRONMENT": "dev",
				"ENROLL_BASE_URL": "https://cp-dev.veyl.dessage.xyz",
				"CREDENTIAL_KEY_ID": "cp-2026-11",
				// Dodo Test Mode 充值产品（Veyl 自己建，不沿用 TweetPilot）；键是美分面额，prod 等验收后再填 Live 产品。
				"DODO_TOPUP_PRODUCT_IDS": "{\"1000\":\"pdt_0Ns2VqGyVh6DSR7wkyWJo\",\"2000\":\"pdt_0Ns2WKHrFEQIAnDX6lews\",\"5000\":\"pdt_0Ns2WRb8m4NSiW4EqhDIP\",\"10000\":\"pdt_0Ns2WXZbLtBhh0YytV5ud\"}",
				// 日价（USD 分/天）是唯一售价真源，月价 = 日价 × 30。
				"PLAN_DAILY_PRICE_CENTS": "{\"s-1vcpu-512mb-10gb\":20,\"s-1vcpu-1gb\":30,\"s-1vcpu-2gb\":60}",
				"APP_PAYMENT_RETURN_URL": "https://cp-dev.veyl.dessage.xyz/payment/return"
			},
			// 代码里统一用 env.DB；生产环境后面单独建库再加一条顶层配置。
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "veyl-control-plane-dev-4",
					"database_id": "a5755c55-b1d3-41fa-a2e1-e6a6a6627824"
				}
			]
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "veyl-control-plane",
			"database_id": "736d423d-47bb-435c-8d74-dfe9244c5833"
		}
	]
}
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "veyl-control-plane",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	// 回调样本捕获开关：生产包注入 "0"，dev 包注入 "1"。
	"define": {
		"__WEBHOOK_SAMPLE__": "\"0\""
	},
	// 压缩产物：未压缩时 esbuild 不会折掉 `if (false)` 这类常量分支，
	// define 开关要靠它才真正把 dev 专用代码从生产包里删掉。
	"minify": true,
	// minify 之后异常堆栈是压缩帧；上传 source map 才能在 Cloudflare 的异常视图
	// 里映射回源码。运行时零开销，dev 一并继承。
	"upload_source_maps": true,
	// 国内分流规则集：import 进 Worker 时按 Data 模块打成 ArrayBuffer（src/rules.ts 只读下发）。
	// .srs 给 sing-box，.mrs 给 Clash；fallthrough 让默认的 `.bin` 规则继续生效。
	"rules": [{ "type": "Data", "globs": ["**/*.srs", "**/*.mrs"], "fallthrough": true }],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	// 让 Worker 尽量在离上游（Vultr API）近的机房执行，出口 IP 随之变化。
	"placement": {
		"mode": "smart"
	},
	// 每小时计费：到期前 1 小时进入可扣窗口，续期扣费、补建「已付没机器」、对账
	// （login-and-payment.md §4.6）。没有这一段，scheduled() 永远不会触发；
	// 时间是 UTC，避开整点高峰（每小时第 17 分）。
	"triggers": {
		"crons": ["17 * * * *"]
	},
	// 默认环境 = 生产。部署：npm run deploy
	"vars": {
		"ENVIRONMENT": "production",
		// 官网站点：问题墙帖子链接与允许的跨域来源。
		"PUBLIC_SITE_URL": "https://veyl.dessage.xyz",
		// 写进 cloud-init 的回传地址；必须与部署后的实际地址一致。
		"ENROLL_BASE_URL": "https://veyl.dessage.xyz",
		// 生产使用独立的凭据签名密钥（dev 是 cp-2026-11），公钥内置在客户端。
		"CREDENTIAL_KEY_ID": "cp-2026-12",
		// UI 快捷充值档（USD 分）：仅快捷按钮，不是支付白名单。$6 / $10 / $25 / $50 / $100。
		"TOPUP_DENOMINATIONS_CENTS": "[600,1000,2500,5000,10000]",
		// 自定义充值范围（USD 分）：$6–$300，整美元。
		"MIN_TOPUP_CENTS": "600",
		"MAX_TOPUP_CENTS": "30000",
		// 日价（USD 分/天）是唯一售价真源，月价 = 日价 × 30。
		"PLAN_DAILY_PRICE_CENTS": "{\"s-1vcpu-512mb-10gb\":30,\"s-1vcpu-1gb\":40,\"s-1vcpu-2gb\":80}",
		"APP_PAYMENT_RETURN_URL": "https://veyl.dessage.xyz/payment/return",
		// 节点 agent（node-agent-mcp.md §4）：cloud-init 只下载、校验、安装。
		// 发布 agent 时把版本、sha256、下载地址换成当次 release 的真实值。
		// sha256 必须是 64 位十六进制：占位符对不上时建机请求直接失败（agent_unconfigured），
		// 不会先建出一台注定起不来的机器。
		"AGENT_VERSION": "0.1.7",
		"AGENT_SHA256": "9e684979c4d860f5fc54a3ed0ee3511b35c7277bcc09db8276d8b1c466cbba09",
		"AGENT_DOWNLOAD_URL": "https://github.com/aiwithblockchain/veyl/releases/download/agent-v0.1.7/veyl-agent-linux-amd64",
		// 期望状态下发给 agent 的 sing-box 版本与下载地址。
		"SING_BOX_VERSION": "1.14.4",
		"SING_BOX_SHA256": "699a1b510aa4396b2176d32d1181920399ebf1e267835da6f3b598d0f7c24968",
		"SING_BOX_DOWNLOAD_URL": "https://github.com/SagerNet/sing-box/releases/download/v1.14.4/sing-box-1.14.4-linux-amd64.tar.gz",
		// 节点 MCP 一次性令牌的 key_id（与凭据签名的 CREDENTIAL_KEY_ID 分开）。
		"AGENT_TOKEN_KEY_ID": "agent-2026-11"
	},
	// Secrets（通过 wrangler secret put 设置，不写在此文件）：
	// - DO_API_TOKEN（DigitalOcean；缺省时 /v1/catalog 返回 503）
	// - TOKEN_SIGNING_JWK（访问令牌签名）
	// - CREDENTIAL_SIGNING_JWK / CREDENTIAL_ENC_KEY（节点凭据签名与加密）
	// - AGENT_TOKEN_SIGNING_JWK（节点 MCP 一次性令牌；独立密钥，不与凭据签名共用）
	// - MOBILE_TOKEN_ENC_KEY（手机导出令牌加密）
	// - STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET（dev、prod 各一套，test 与 live 不混用）
	// - RESEND_API_KEY / RESEND_FROM_EMAIL（邮箱验证码）
	"env": {
		// 开发 / 联调环境。部署：npm run deploy:dev
		"dev": {
			"name": "veyl-control-plane-dev",
			"define": {
				"__WEBHOOK_SAMPLE__": "\"1\""
			},
			// 继承顶层的 cron：每小时第 17 分会用 dev D1 里的真实订单跑续费 / 停机销毁，
			// 这是有意保留的——不然 dev 没法测计费。
			"vars": {
				"ENVIRONMENT": "dev",
				"PUBLIC_SITE_URL": "https://veyl-edge-dev.pages.dev",
				"ENROLL_BASE_URL": "https://dev.veyl.dessage.xyz",
				"CREDENTIAL_KEY_ID": "cp-2026-11",
				// UI 快捷充值档（USD 分）：仅快捷按钮，不是支付白名单。$6 / $10 / $25 / $50 / $100。
				"TOPUP_DENOMINATIONS_CENTS": "[600,1000,2500,5000,10000]",
				// 自定义充值范围（USD 分）：$6–$300，整美元。
				"MIN_TOPUP_CENTS": "600",
				"MAX_TOPUP_CENTS": "30000",
				// 日价（USD 分/天）是唯一售价真源，月价 = 日价 × 30。
				"PLAN_DAILY_PRICE_CENTS": "{\"s-1vcpu-512mb-10gb\":30,\"s-1vcpu-1gb\":40,\"s-1vcpu-2gb\":80}",
				"APP_PAYMENT_RETURN_URL": "https://dev.veyl.dessage.xyz/payment/return",
				// 同生产：发布 agent 时换成当次 release 的真实值（dev 可以先指向 pre-release）。
				"AGENT_VERSION": "0.1.7",
				"AGENT_SHA256": "9e684979c4d860f5fc54a3ed0ee3511b35c7277bcc09db8276d8b1c466cbba09",
				"AGENT_DOWNLOAD_URL": "https://github.com/aiwithblockchain/veyl/releases/download/agent-v0.1.7/veyl-agent-linux-amd64",
				"SING_BOX_VERSION": "1.14.4",
				"SING_BOX_SHA256": "699a1b510aa4396b2176d32d1181920399ebf1e267835da6f3b598d0f7c24968",
				"SING_BOX_DOWNLOAD_URL": "https://github.com/SagerNet/sing-box/releases/download/v1.14.4/sing-box-1.14.4-linux-amd64.tar.gz",
				"AGENT_TOKEN_KEY_ID": "agent-2026-11"
			},
			// 代码里统一用 env.DB；生产环境后面单独建库再加一条顶层配置。
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "veyl-control-plane-dev-4",
					"database_id": "a5755c55-b1d3-41fa-a2e1-e6a6a6627824"
				}
			]
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "veyl-control-plane",
			"database_id": "736d423d-47bb-435c-8d74-dfe9244c5833"
		}
	]
}
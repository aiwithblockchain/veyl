{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "veyl-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "1440"
      ],
      "port": 1440
    },
    {
      "name": "veyl-site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "site"
      ],
      "port": 4173
    },
    {
      "name": "veyl-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4174",
        "--directory",
        "docs/design/prototype"
      ],
      "port": 4174
    }
  ]
}

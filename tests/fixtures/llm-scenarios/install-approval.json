{
  "name": "install-approval",
  "description": "运行时未安装：触发 core_install 后完成连接",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "CoreInstall",
          "arguments": {
            "version": "1.14.4"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "ConfigCreate",
          "arguments": {
            "name": "默认配置",
            "connect_mode": "system_proxy",
            "routing_mode": "proxy_all",
            "source": "seed"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "VpnConnect",
          "arguments": {
            "config_id": "cfg_seed"
          }
        }
      ]
    },
    {
      "text": "运行时已安装并连接成功，出口 IP 203.0.113.7。"
    }
  ]
}

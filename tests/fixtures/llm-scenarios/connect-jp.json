{
  "name": "connect-jp",
  "description": "主流程：查节点 → 导入 → 连接 → 汇报",
  "turns": [
    {
      "tool_calls": [
        {
          "name": "CatalogSearch",
          "arguments": {
            "region": "jp",
            "limit": 10
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "ProfileImport",
          "arguments": {
            "node_id": "seed-jp-01"
          }
        }
      ]
    },
    {
      "tool_calls": [
        {
          "name": "VpnConnect",
          "arguments": {
            "node_id": "seed-jp-01",
            "strategy": "latency"
          }
        }
      ]
    },
    {
      "text": "已连接到 东京 01，出口 IP 203.0.113.7。"
    }
  ]
}
